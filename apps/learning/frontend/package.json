{
  "name": "codeos-learning-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:writing-preview": "vite build --config vite.writing.config.ts",
    "predev": "npm run build:writing-preview",
    "prebuild": "npm run build:writing-preview",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:browser": "node tests/workspace-browser-check.cjs",
    "test:notes": "node --test tests/writing-workspace.test.mjs tests/notes-editor.test.mjs",
    "test:writing-preview": "npm run build:writing-preview && node --test tests/writing-preview.test.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.12",
    "@lezer/highlight": "^1.2.5",
    "@uiw/react-codemirror": "^4.25.11",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^6.0.5"
  }
}
